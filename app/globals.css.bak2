@import "tailwindcss";

/* ─── Design tokens ─── */
:root {
  --bg:           #ffffff;
  --fg:           #111111;
  --fg-muted:     #999999;
  --border:       #e8e8e8;
  --card-bg:      #ffffff;
  --card-hover:   var(--color-bg-gray);
  --accent:       #111111;

  /* 参考サイト由来のカラー */
  --color-primary:     #1395ac;
  --color-accent:      #f6e500;
  --color-bg-gray:     #edf2f4;
  --color-dark-blue:   #2c5a6d;
  --color-teal:        #3c9d9b;
  --color-teal-muted:  #3c9d9b99; /* 半透明ティール */

  /* グラデーション */
  --gradient-nav: linear-gradient(132deg, rgb(77, 135, 200) 0%, rgb(19, 149, 172) 78%);

  /* トランジション */
  --transition:      .5s ease;
  --transition-fast: .3s ease;
}

@theme inline {
  --color-background: var(--bg);
  --color-foreground: var(--fg);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

/* ─── Base ─── */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
  scrollbar-gutter: stable;
}

body {
  background: var(--bg);
  color: #282828;
  font-family:"Hiragino Sans", "ヒラギノ角ゴシック",
    "Hiragino Kaku Gothic ProN", "ヒラギノ角ゴ ProN W3", "メイリオ", Meiryo,
    sans-serif;
  font-weight: 500;
  font-style: normal;
  line-height: 1.4;
  letter-spacing: .05em;
  font-display: swap;
  -webkit-text-size-adjust: 100%;
  -webkit-overflow-scrolling: touch;
  position: relative;
  width: 100%;
}

/* ─── Typography ─── */
h1, h2, h3, h4 {
  letter-spacing: -0.03em;
  line-height: 1.4;
  font-weight: 700;
}

p {
  color: var(--fg-muted);
  line-height: 1.4;
}

/* テキスト選択時の背景色 */
*::selection {
  background: rgba(0, 0, 0, 0.2);
}

/* sub / sup */
sub, sup {
  font-size: 75%;
  line-height: 0;
  position: relative;
  vertical-align: baseline;
}
sub { bottom: -5px; }
sup { top: -5px; }

/* 画像 */
img {
  max-width: 100%;
  height: auto;
}

/* a {
  color: #111;
  text-decoration: none;
  transition: var(--transition);
} */

a:not([class]) {
  -webkit-text-decoration-skip: ink;
  text-decoration-skip-ink: auto;
}

a:hover {
  opacity: 0.55;
}

a.nav-btn:hover,
a.group:hover {
  opacity: 1 !important;
}

/* ─── Sections ─── */
section {
  scroll-margin-top: 80px;
}

/* ─── Cards (WorkCard, Process, Skills) ─── */
.card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.75rem;
  transition: background var(--transition-fast), box-shadow var(--transition-fast);
}

.card:hover {
  background: var(--card-hover);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

/* ─── Labels / Tags ─── */
.label {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-muted);
}

/* ─── Header nav button ─── */
.nav-title {
  color: #1f1f1f;
  opacity: 1;
  font-size: 16px;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0;
  min-width: 80px;
  padding: 9px 20px;
  border-radius: 48px;
  background-color: #1f1f1f;
  border: 2px solid #1f1f1f;
  color: #fff !important;
  cursor: pointer;
  text-decoration: none !important;
  transition: all 0.3s;
  opacity: 1 !important;
}

.nav-btn:hover {
  background-color: #fff !important;
  color: #1f1f1f !important;
  opacity: 1 !important;
}
hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 0;
}

/* ─── Section heading (トップページ用) ─── */
.section-heading {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  padding-left: 16px;
  position: relative;
  color: #1f1f1f;
}

.section-heading::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  border-radius: 4px;
  background: var(--gradient-nav);
}

.btn_more {
/* text-align: center; */
 margin: 30px auto 0px;
}

.btn_works {
text-align: center;
}

.btn_more a {
  display: inline-flex;
  justify-content: center;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0;
  min-width: 200px;
  padding: 12px 20px 12px 20px;
  border-radius: 48px;
  background-color: #1f1f1f;
  border: 2px solid #1f1f1f;
  color: #fff !important;
  cursor: pointer;
  text-decoration: none !important;
  transition: all 0.3s;
  opacity: 1 !important;
}
.btn_more a:hover {
  background-color: #fff !important;
  color: #1f1f1f !important;
  opacity: 1 !important;
}
.btn_more a:hover {
  opacity: 1 !important;
}

/* ─── Entry / Article page ─── */

/* ページ全体のコンテナ */
.entry-page {
  max-width: 100%;
  margin: 0 auto;
  padding: 80px 0 60px;
}

/* ヘッダー部分 */
.entry-header {
  padding: 10px 0 5px;
  margin-bottom: 30px;
}

.entry-header__category {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-muted);
  display: block;
  margin-bottom: 12px;
}

.entry-header > h1 {
  line-height: 1.4;
  font-size: 2.5em;
  letter-spacing: .03em;
  color: var(--color-primary);
  background: var(--gradient-nav);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: rgba(0, 0, 0, 0);
  margin-bottom: 30px;
  position: relative;
  z-index: 2;
  font-weight: 600;
}

/* 記事本文エリア */
.entry-content {
  padding: 40px 0 50px;
  line-height: 1.9;
  width: 100%;
}

.entry-content > p {
  margin-bottom: 25px;
  font-size: 16px;
  color: #1f1f1f;
}

/* h2: 左カラーバー付き（グラデーション） */
.entry-content > h2 {
  font-size: 1.4em;
  font-weight: 700;
  padding: 10px 18px;
  position: relative;
  margin-top: 60px;
  margin-bottom: 28px;
  color: var(--fg);
}

.entry-content > h2::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  border-radius: 4px;
  background: var(--gradient-nav);
}

/* h3: ティール背景付き */
.entry-content > h3 {
  font-size: 1.4em;
  font-weight: 700;
  color: #fff;
  background: #1395acb3;
  padding: 15px 20px;
  margin-top: 48px;
  margin-bottom: 20px;
  border-radius: 0;
}

/* ─── Pager (prev / next) ─── */
.pager-list {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  flex-wrap: wrap;
  margin-top: 80px;
  border-top: 1px solid var(--border);
  padding-top: 40px;
}

[class^="pager-item--"] {
  width: 50%;
  position: relative;
}

[class^="pager-item--"] .pager-item__link {
  padding: 16px 24px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  transition: opacity 0.15s ease;
}

.pager-item--next .pager-item__link {
  align-items: flex-end;
  text-align: right;
}

.pager-item__label {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-muted);
  margin-bottom: 6px;
}

.pager-item__link > p {
  font-size: 0.9rem;
  line-height: 1.4;
  color: var(--fg);
}

.pager-item--prev {
  border-right: 1px solid var(--border);
}

[class^="pager-item--"] .pager-item__link:hover {
  color: var(--color-teal);
  opacity: 1;
}

/* ─── Breadcrumb ─── */
.breadcrumb {
  margin: 0 0 40px;
}

.breadcrumb-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
}

.breadcrumb-item {
  font-size: 0.75rem;
  color: var(--fg-muted);
}

.breadcrumb-item:not(:last-child)::after {
  content: " / ";
  margin: 0 4px;
  color: var(--fg-muted);
}

.breadcrumb-item a {
  color: var(--fg-muted);
  transition: var(--transition);
}

.breadcrumb-item a:hover {
  color: var(--color-teal);
  opacity: 1;
}

@media screen and (max-width: 767px) {
  .entry-page {
    padding: 40px 0 40px;
  }

  .entry-header > h1 {
    font-size: 1.7em;
  }

  .entry-content > h2 {
    font-size: 1.2em;
    padding: 8px 14px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .entry-content > h2::before {
    width: 3px;
  }

  .entry-content > h3 {
    font-size: 1.05em;
    padding: 10px 14px;
  }

  [class^="pager-item--"] {
    width: 100%;
  }

  .pager-item--prev {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  [class^="pager-item--"] .pager-item__link {
    padding: 14px 16px;
  }
}

/* ─── 参考CSS追加スタイル ─── */

/* eyecatch */
.eyecatch {
  width: 100%;
  max-height: 420px;
  overflow: hidden;
  border-radius: 8px;
}

.eyecatch img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  max-height: 420px;
}

/* tags-block */
.tags-block {
  margin-bottom: 100px;
}

.tags-block > ul {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  flex-wrap: wrap;
}

.tags-block > ul > li {
  margin-right: 30px;
  margin-bottom: 20px;
}

.tags-block > ul a {
  border: 1px solid #707070;
  border-radius: 35px;
  display: inline-block;
  padding: 8px 45px;
  font-size: .9em;
  transition: var(--transition);
}

@media screen and (min-width: 768px) {
  .tags-block > ul a:hover {
    background-color: #707070;
    color: #fff;
  }
}

/* entry-content リスト */
.entry-content > ul,
.entry-content > ol {
  background-color: #fff;
  padding: 20px 50px;
  margin-bottom: 40px;
}

.entry-content ul li {
  list-style: disc;
}

.entry-content ol li {
  list-style: decimal-leading-zero;
}

/* entry-content blockquote */
.entry-content blockquote {
  background-color: #f8f9fa;
  padding: 20px 24px 20px 28px;
  margin-bottom: 40px;
  position: relative;
  border-left: 4px solid var(--color-teal);
  border-radius: 0 6px 6px 0;
}

.entry-content blockquote cite {
  color: #444;
  font-size: .85em;
  margin-top: 10px;
  display: block;
}

/* entry-content table */
.entry-content table {
  width: 100%;
  margin-bottom: 40px;
  border-collapse: collapse;
  font-size: .95em;
}

.entry-content table thead th,
.entry-content table th {
  background-color: #2c5a6d;
  color: #fff;
  font-weight: 600;
  padding: 10px 14px;
  text-align: left;
  font-size: .9em;
}

.entry-content table tr:nth-child(even) {
  background-color: #f8f9fa;
}

.entry-content table tr:nth-child(odd) {
  background-color: #fff;
}

.entry-content table td {
  padding: 10px 14px;
  border-bottom: 1px solid #eee;
}

.entry-content table td:not(:last-child),
.entry-content table th:not(:last-child) {
  border-right: 1px solid rgba(0, 0, 0, .08);
}

/* スマホ対応 */
@media screen and (max-width: 767px) {
  .entry-header > h1 {
    font-size: 22px;
  }

  .entry-content > h3 {
    font-size: 1.2em;
    padding: 10px 14px;
  }

  .tags-block > ul > li {
    margin-right: 10px;
    margin-bottom: 10px;
  }

  .tags-block > ul a {
    border-radius: 25px;
    padding: 8px 20px;
  }

  .entry-content > ul,
  .entry-content > ol {
    padding: 15px 35px;
  }
}

/* ─── Gallery card ─── */
.gallery-card {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background-color: #F4F4F4;
  border-radius: 8px;
  overflow: hidden;
  pointer-events: none;
  user-select: none;
}

.gallery-card__img {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  object-fit: contain !important;
  background-color: #F4F4F4;
}

/* ─── Page layout ─── */
.page-main {
  max-width: 1024px;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
}

/* ─── Page title (gradient) ─── */
.page-title {
  padding: 0;
  margin: 0 0 80px 0;
}

.page-title__text {
  line-height: 1.4;
  font-size: 2.5em;
  letter-spacing: .03em;
  background: var(--gradient-nav);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 600;
  display: inline-block;
}

/* ─── Text colors ─── */
.color-primary {
  color: #1f1f1f;
}

.color-muted {
  color: #999;
}

.color-sub {
  color: #797979;
}

/* ─── Text sizes ─── */
.text-body {
  color: #1f1f1f;
  line-height: 1.6;
  font-size: 16px;
}

.text-body-sm {
  font-size: 14px;
  color: #1f1f1f;
}

.text-note {
  font-size: 12px;
}

/* ─── Hero ─── */
.hero-title {
  color: #1f1f1f;
  letter-spacing: 0.1em;
}

.hero-sub {
  color: #1f1f1f;
}

/* ─── Profile ─── */
.profile-img-wrap {
  width: 300px;
}

.profile-name {
  color: #1f1f1f;
}

.profile-name-en {
  color: #999;
}

/* ─── Career table ─── */
.career-table {
  color: #1f1f1f;
  font-size: 16px;
  line-height: 1.6;
}

.career-table th {
  color: #999;
}

/* ─── Skill cards ─── */
.skill-card {
  background-color: #f4f4f4;
  padding: 24px;
  border-radius: 8px;
}

.skill-card__label {
  color: #797979;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.08em;
}

.skill-card__content {
  color: #1f1f1f;
  line-height: 1.6;
  font-size: 16px;
}

/* ─── Works filter ─── */
.filter-wrap {
  margin-bottom: 24px;
}

.filter-count {
  color: #999;
}

.filter-select {
  background-color: #f4f4f4;
  color: #1f1f1f;
  border: none;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  font-size: 16px;
  padding-left: 16px;
  padding-right: 40px;
}

.filter-icon {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  font-size: 14px;
  color: #1f1f1f;
}

/* ─── Work card elements ─── */
.work-card__thumb {
  aspect-ratio: 4 / 3;
  background-color: #F4F4F4;
}

.work-card__thumb img {
  background-color: #F4F4F4;
}

.work-card__overlay-text {
  font-size: 18px;
}

.work-card__date {
  font-size: 12px;
  color: #999;
  margin-top: 16px;
}

.work-card__title {
  font-size: 16px;
  color: #1f1f1f;
  margin-top: 8px;
}

.work-card__tags {
  margin-top: 16px;
}

.work-card__tag {
  background-color: #f4f4f4;
  color: #1f1f1f;
}

/* ─── Work detail ─── */
.work-detail__article {
  width: 100%;
}

.work-detail__header {
  width: 100%;
}

.work-detail__h1 {
  padding: 0;
  margin: 0;
  line-height: 1.4666;
  font-size: 2.5em;
  letter-spacing: .03em;
  background: var(--gradient-nav);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 600;
}

.work-detail__tags {
  margin-top: 16px;
}

.work-detail__meta {
  font-size: 14px;
}

.work-detail__meta dt {
  color: #999;
}

.work-detail__meta dd {
  color: #1f1f1f;
}

.work-detail__back {
  margin-top: 80px;
  padding-top: 80px;
  padding-bottom: 80px;
}

/* ─── Gallery ─── */
.gallery-item {
  background-color: #F4F4F4;
}

.gallery-item img {
  aspect-ratio: 4 / 3;
  object-fit: contain;
  background-color: #F4F4F4;
}

/* ─── Header (SP) ─── */
.header-h1 {
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  letter-spacing: inherit;
}

.header-subtitle {
  color: #999;
}

.header-hamburger {
  color: #1f1f1f;
}

.sp-menu {
  padding-top: 150px;
}

.sp-menu__link {
  width: 80%;
  min-width: unset;
  height: auto;
  padding: 12px 18px;
  font-size: 16px;
}

/* ─── Section heading with margin ─── */
.section-heading--spaced {
  margin-top: 60px;
  margin-bottom: 40px;
}
