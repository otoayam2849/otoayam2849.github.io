@import "tailwindcss";

/* ─── Design tokens ─── */
:root {
  --bg:           #ffffff;
  --fg:           #111111;
  --fg-muted:     #707070;
  --border:       #e8e8e8;
  --card-bg:      #ffffff;
  --card-hover:   var(--color-bg-gray);
  --accent:       #111111;

  /* 参考サイト由来のカラー */
  --color-primary:     #1395ac;
  --color-accent:      #f6e500;
  --color-bg-gray:     #edf2f4;
  --color-dark-blue:   #2c5a6d;
  --color-teal:        #3c9d9b;
  --color-teal-muted:  #3c9d9b99; /* 半透明ティール */

  /* グラデーション */
  --gradient-nav: linear-gradient(132deg, rgb(77, 135, 200) 0%, rgb(19, 149, 172) 78%);

  /* トランジション */
  --transition:      .5s ease;
  --transition-fast: .3s ease;
}

@theme inline {
  --color-background: var(--bg);
  --color-foreground: var(--fg);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

/* ─── Base ─── */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  background: var(--bg);
  color: var(--fg);
  font-family: dnp-shuei-gothic-gin-std, "Hiragino Sans", "ヒラギノ角ゴシック",
    "Hiragino Kaku Gothic ProN", "ヒラギノ角ゴ ProN W3", "メイリオ", Meiryo,
    sans-serif;
  line-height: 1.6;
  font-display: swap;
}

/* ─── Typography ─── */
h1, h2, h3, h4 {
  letter-spacing: -0.03em;
  line-height: 1.15;
  font-weight: 700;
}

p {
  color: var(--fg-muted);
  line-height: 1.8;
}

a {
  color: var(--fg);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  opacity: 0.55;
}

/* ─── Sections ─── */
section {
  scroll-margin-top: 80px;
}

/* ─── Cards (WorkCard, Process, Skills) ─── */
.card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.75rem;
  transition: background var(--transition-fast), box-shadow var(--transition-fast);
}

.card:hover {
  background: var(--card-hover);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

/* ─── Labels / Tags ─── */
.label {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-muted);
}

/* ─── Divider ─── */
hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 0;
}

/* ─── Section heading (トップページ用) ─── */
.section-heading {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  padding-left: 16px;
  position: relative;
  color: var(--fg);
}

.section-heading::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  border-radius: 4px;
  background: var(--gradient-nav);
}

/* ─── Entry / Article page ─── */

/* ページ全体のコンテナ */
.entry-page {
  max-width: 750px;
  margin: 0 auto;
  padding: 80px 0 60px;
}

/* ヘッダー部分 */
.entry-header {
  padding: 10px 0 5px;
  margin-bottom: 30px;
}

.entry-header__category {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-muted);
  display: block;
  margin-bottom: 12px;
}

.entry-header > h1 {
  line-height: 1.3;
  font-size: 2.4em;
  letter-spacing: -0.03em;
  color: var(--fg);
  margin-bottom: 24px;
  font-weight: 700;
}

/* 記事本文エリア */
.entry-content {
  padding: 40px 0 50px;
  line-height: 1.9;
}

.entry-content > p {
  margin-bottom: 25px;
  word-break: break-all;
  font-size: 1.05em;
  color: var(--fg-muted);
}

/* h2: 左カラーバー付き（グラデーション） */
.entry-content > h2 {
  font-size: 1.4em;
  font-weight: 700;
  padding: 10px 18px;
  position: relative;
  margin-top: 60px;
  margin-bottom: 28px;
  color: var(--fg);
}

.entry-content > h2::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  border-radius: 4px;
  background: var(--gradient-nav);
}

/* h3: ティール背景付き */
.entry-content > h3 {
  font-size: 1.15em;
  font-weight: 700;
  color: #fff;
  background: var(--color-teal-muted);
  padding: 12px 18px;
  margin-top: 48px;
  margin-bottom: 20px;
  border-radius: 6px;
}

/* ─── Pager (prev / next) ─── */
.pager-list {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  flex-wrap: wrap;
  margin-top: 80px;
  border-top: 1px solid var(--border);
  padding-top: 40px;
}

[class^="pager-item--"] {
  width: 50%;
  position: relative;
}

[class^="pager-item--"] .pager-item__link {
  padding: 16px 24px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  transition: opacity 0.15s ease;
}

.pager-item--next .pager-item__link {
  align-items: flex-end;
  text-align: right;
}

.pager-item__label {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-muted);
  margin-bottom: 6px;
}

.pager-item__link > p {
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--fg);
}

.pager-item--prev {
  border-right: 1px solid var(--border);
}

[class^="pager-item--"] .pager-item__link:hover {
  color: var(--color-teal);
  opacity: 1;
}

/* ─── Breadcrumb ─── */
.breadcrumb {
  margin: 20px 0 40px;
}

.breadcrumb-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
}

.breadcrumb-item {
  font-size: 0.75rem;
  color: var(--fg-muted);
}

.breadcrumb-item:not(:last-child)::after {
  content: " › ";
  margin: 0 4px;
  color: var(--border);
}

.breadcrumb-item a {
  color: var(--fg-muted);
  transition: var(--transition);
}

.breadcrumb-item a:hover {
  color: var(--color-teal);
  opacity: 1;
}

@media screen and (max-width: 767px) {
  .entry-page {
    padding: 40px 0 40px;
  }

  .entry-header > h1 {
    font-size: 1.7em;
  }

  .entry-content > h2 {
    font-size: 1.2em;
    padding: 8px 14px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .entry-content > h2::before {
    width: 3px;
  }

  .entry-content > h3 {
    font-size: 1.05em;
    padding: 10px 14px;
  }

  [class^="pager-item--"] {
    width: 100%;
  }

  .pager-item--prev {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  [class^="pager-item--"] .pager-item__link {
    padding: 14px 16px;
  }
}